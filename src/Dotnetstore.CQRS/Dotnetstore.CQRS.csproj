<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Dotnetstore.CQRS</PackageId>
    <Version>0.1.0</Version>
    <Authors>Hans Sjödin</Authors>
    <Description>Lightweight CQRS library for .NET: commands, queries, notifications, stream requests and a pipeline with behaviors, pre/post processors and exception handlers. A free, MIT-licensed alternative to MediatR.</Description>
    <PackageTags>cqrs;mediator;commands;queries;messaging;pipeline;mediatr-alternative</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/hasse29/Dotnetstore.CQRS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hasse29/Dotnetstore.CQRS.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Marker interfaces and MediatR-compatible names (next, ...Delegate) are intentional. -->
    <NoWarn>$(NoWarn);CA1040;CA1711;CA1716</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dotnetstore.CQRS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
